                  "name": "Policy Sections",
                  "width": "fill_container",
                  "layout": "vertical",
                  "children": [
                    {
                      "id": "U8z05p",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Agreement",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Agreement"
                        },
                        "DFkPe": {
                          "content": "By downloading, installing, accessing, or using Penkra, you agree to these Terms and the Privacy Policy. If you do not agree, do not use the services.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "If you use Penkra for an organization, you represent that you have authority to accept these Terms for that organization. “Penkra” includes penkra.com, Penkra accounts, the desktop app, bundled Apps, and Penkra-operated release and update services.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "content": "Some parts of Penkra are open-source software governed by their license. These Terms govern Penkra-operated services and your use of official builds; the open-source license governs your rights in the source code.",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "Ztj4X",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Eligibility and accounts",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Eligibility and accounts"
                        },
                        "DFkPe": {
                          "content": "You must be at least 13 years old and legally able to enter into these Terms. If local law requires a higher age for an online service, that higher age applies.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "You are responsible for accurate account information, safeguarding your password and device, and activity performed through your account. Notify security@penkra.com if you believe an account or official build has been compromised.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "content": "Penkra may use email verification, session controls, device authorization, or other reasonable safeguards to protect accounts and releases.",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "W4mPV9",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Open-source license and cost",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Open-source license and cost"
                        },
                        "DFkPe": {
                          "content": "Penkra’s source code is available under the MIT License. The license included with the source controls your rights to copy, modify, distribute, or use that software.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "Penkra is currently free. AI providers, network operators, or third-party services may charge their own subscription, API, storage, or usage fees. You are responsible for reviewing and paying those charges.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "content": "We may introduce optional paid services in the future only with clear terms and pricing before you incur a charge.",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "MrIVf",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Your content and instructions",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Your content and instructions"
                        },
                        "DFkPe": {
                          "content": "You retain ownership of the prompts, files, messages, code, and other material you provide or create. You grant Penkra the limited rights needed to process that material to operate features you request.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "You are responsible for your instructions, approvals, selected files, connected accounts, and outputs you choose to use or publish. Review agent output before relying on it, especially for consequential, security-sensitive, financial, medical, or legal work.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "content": "Do not provide content or access that you do not have the right to use, disclose, modify, or transmit.",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "NlPNU",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Agents, Apps, and third parties",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Agents, Apps, and third parties"
                        },
                        "DFkPe": {
                          "content": "Penkra coordinates AI providers and tools selected by you. Provider responses may be inaccurate, incomplete, biased, or unsafe. Provider availability, model behavior, limits, and data practices are controlled by the provider and governed by its terms.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "Apps receive only the arguments, capabilities, and permissions made available to them. You are responsible for reviewing requested permissions and deciding whether to install or use an App. Third-party Apps are the responsibility of their publishers unless Penkra expressly states otherwise.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "content": "Third-party websites, accounts, repositories, and services remain subject to their own terms. Penkra is not responsible for third-party service changes, charges, content, or availability.",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "E2gr0Z",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Acceptable use",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Acceptable use"
                        },
                        "DFkPe": {
                          "content": "Do not use Penkra to violate law; infringe intellectual property or privacy; distribute malware; bypass access controls; obtain unauthorized credentials; harass, exploit, or harm others; or interfere with Penkra, a provider, an App, or another service.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "Do not misrepresent agent output as verified human work when that distinction is material. Do not use Penkra to make fully automated high-impact decisions about a person without the review and safeguards required by applicable law.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "content": "We may block access to Penkra-operated services or releases when reasonably necessary to address abuse, security risk, legal requirements, or material violations of these Terms.",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "z4BfNj",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Updates and availability",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Updates and availability"
                        },
                        "DFkPe": {
                          "content": "Penkra may download or offer software updates, security fixes, App metadata, or release information. Keep the app updated when an update addresses a known security or compatibility issue.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "Features may change, break, become unavailable, or be removed. Preview, canary, or development builds may be unstable and should not be relied on for critical work without backups.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "content": "You are responsible for maintaining backups of important files and workspace data. Penkra does not guarantee uninterrupted operation, compatibility with every provider, or permanent availability of any third-party integration.",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "OjuaX",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Disclaimers and liability",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Disclaimers and liability"
                        },
                        "DFkPe": {
                          "content": "To the maximum extent permitted by law, Penkra and the official software are provided “as is” and “as available,” without warranties of merchantability, fitness for a particular purpose, non-infringement, accuracy, or uninterrupted operation. Rights that cannot be waived under applicable law remain unaffected.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "To the maximum extent permitted by law, Penkra and its contributors will not be liable for indirect, incidental, special, consequential, exemplary, or punitive damages, or for loss of data, profits, goodwill, or business opportunity arising from use of the services.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "enabled": true,
                          "content": "Where liability cannot be excluded, total liability for claims relating to the free services will be limited to the greater of the amount you paid Penkra for the service giving rise to the claim in the prior twelve months or US $100."
                        }
                      }
                    },
                    {
                      "id": "c4j7GJ",
                      "type": "ref",
                      "ref": "H47mX",
                      "name": "Suspension, changes, and contact",
                      "width": "fill_container",
                      "descendants": {
                        "z0SqgS": {
                          "content": "Suspension, changes, and contact"
                        },
                        "DFkPe": {
                          "content": "You may stop using Penkra at any time and may request deletion of your Penkra account. Uninstalling the desktop app may not remove files created outside Penkra’s application data directory.",
                          "enabled": true
                        },
                        "O9oXew": {
                          "content": "We may suspend or end access to Penkra-operated services for security, legal, or material Terms violations. We may update these Terms by posting the revised version and changing the effective date; material changes may also be announced in the app or by email.",
                          "enabled": true
                        },
                        "i1dhU": {
                          "enabled": true,
                          "content": "Questions about these Terms can be sent to legal@penkra.com. Security reports should be sent to security@penkra.com."
                        }
                      }
                    }
