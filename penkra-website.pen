              "children": [
                {
                  "id": "l3hHCB",
                  "type": "ref",
                  "ref": "BEJ7d",
                  "name": "How much does Penkra cost?",
                  "descendants": {
                    "K4buKf": {
                      "content": "How much does Penkra cost?"
                    },
                    "ZsuNS": {
                      "content": "Penkra is free and open source under the MIT License. Your AI provider may charge for its own subscription or API usage."
                    }
                  }
                },
                {
                  "id": "piAia",
                  "type": "ref",
                  "ref": "BEJ7d",
                  "name": "Which operating systems does Penkra support?",
                  "descendants": {
                    "K4buKf": {
                      "content": "Which operating systems does Penkra support?"
                    },
                    "ZsuNS": {
                      "content": "Penkra is available for macOS, Windows, and Linux."
                    }
                  }
                },
                {
                  "id": "BUxzr",
                  "type": "ref",
                  "ref": "BEJ7d",
                  "name": "Which agents can I use?",
                  "descendants": {
                    "K4buKf": {
                      "content": "Which agents can I use?"
                    },
                    "ZsuNS": {
                      "content": "Penkra includes Claude Agent, Codex, and OpenCode. You can sign in with Claude or ChatGPT, or connect an API key."
                    }
                  }
                },
                {
                  "id": "Ho7TA",
                  "type": "ref",
                  "ref": "BEJ7d",
                  "name": "Which API-key providers are supported?",
                  "descendants": {
                    "K4buKf": {
                      "content": "Which API-key providers are supported?"
                    },
                    "ZsuNS": {
                      "content": "Connect Anthropic, OpenAI, Google, OpenRouter, or a compatible custom base URL."
                    }
                  }
                },
                {
                  "id": "GCyiM",
                  "type": "ref",
                  "ref": "BEJ7d",
                  "name": "Can Apps read my conversations?",
                  "descendants": {
                    "K4buKf": {
                      "content": "Can Apps read my conversations?"
                    },
                    "ZsuNS": {
                      "content": "No. Apps cannot browse your conversations, folders, threads, settings, or other Apps. They receive only arguments an agent explicitly passes and permissions you approve."
                    }
                  }
                },
                {
                  "id": "S5ldl",
